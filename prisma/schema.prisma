generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  passwordHash     String?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reviews          Review[]
  savedColleges    SavedCollege[]
  savedComparisons SavedComparison[]
  questions        Question[]
  answers          Answer[]
}

model College {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String
  location        String
  state           String
  type            String         // PUBLIC, PRIVATE, DEEMED
  establishedYear Int
  rating          Float          @default(0)
  minFees         Int
  maxFees         Int
  imageUrl        String?
  logoUrl         String?
  website         String?
  approvals       String         @default("[]") // JSON array string
  facilities      String         @default("[]") // JSON array string
  examsAccepted   String         @default("[]") // JSON array string
  ranking         Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  courses         Course[]
  placements      Placement[]
  reviews         Review[]
  savedBy         SavedCollege[]
  questions       Question[]

  @@index([name])
  @@index([state])
  @@index([type])
  @@index([rating])
  @@index([ranking])
}

model Course {
  id        String   @id @default(cuid())
  collegeId String
  name      String
  duration  String
  fees      Int
  type      String   // UG, PG, DIPLOMA, PHD
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([collegeId, type])
}

model Placement {
  id             String   @id @default(cuid())
  collegeId      String
  year           Int
  averagePackage Float
  highestPackage Float
  medianPackage  Float
  placementRate  Float
  topRecruiters  String   @default("[]") // JSON array string
  college        College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@unique([collegeId, year])
}

model Review {
  id        String   @id @default(cuid())
  collegeId String
  userId    String
  rating    Int
  title     String
  content   String
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Question {
  id        String   @id @default(cuid())
  title     String
  content   String
  collegeId String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  college   College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@index([collegeId])
  @@index([userId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  content    String
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model SavedComparison {
  id         String   @id @default(cuid())
  userId     String
  name       String
  collegeIds String   @default("[]") // JSON array string
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

